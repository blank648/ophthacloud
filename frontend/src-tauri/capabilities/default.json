{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "keycloak-login"
  ],
  "permissions": [
    "core:default",
    "shell:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close"
  ],
  "remote": {
    "urls": [
      "http://localhost:8180",
      "http://localhost:8180/*"
    ]
  }
}